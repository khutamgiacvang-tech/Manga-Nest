<!-- Web Push Notification Script -->
<script>
function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const rawData = window.atob(base64);
    return Uint8Array.from([...rawData].map(char => char.charCodeAt(0)));
}

if ('serviceWorker' in navigator && 'PushManager' in window) {
    navigator.serviceWorker.register('/sw.js').then(async function(registration) {
        const permission = await Notification.requestPermission();
        if (permission !== 'granted') return;

        const keyRes = await fetch('/api/vapid-public-key');
        const keyData = await keyRes.json();
        const applicationServerKey = urlBase64ToUint8Array(keyData.publicKey);

        let subscription = await registration.pushManager.getSubscription();

        if (!subscription) {
            try {
                subscription = await registration.pushManager.subscribe({
                    userVisibleOnly: true,
                    applicationServerKey
                });
            } catch (err) {
                // Một số thiết bị/trình duyệt còn giữ subscription cũ được tạo
                // bằng key sai định dạng (chuỗi string thay vì Uint8Array) từ
                // phiên bản trước, khiến subscribe() báo lỗi "applicationServerKey
                // khác với key đang có". Hủy subscription cũ rồi đăng ký lại.
                const staleSubscription = await registration.pushManager.getSubscription();
                if (staleSubscription) {
                    await staleSubscription.unsubscribe();
                }
                subscription = await registration.pushManager.subscribe({
                    userVisibleOnly: true,
                    applicationServerKey
                });
            }
        }

        // Gửi lên server lưu
        fetch('/api/save-subscription', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(subscription)
        });
    }).catch(err => {
        console.log('Service Worker registration failed: ', err);
    });
}
</script>


