<div class="admin-page">

    <h1>🛡 Quản Lý Đơn</h1>

    <!-- ================= Biểu đồ ================= -->

    <div class="charts-row">

        <div class="chart-box">
            <h4>👥 Tổng tài khoản (User / Translator)</h4>
            <canvas id="accountChart"></canvas>
        </div>

        <div class="chart-box">
            <h4>📚 Truyện theo thể loại</h4>
            <canvas id="genreChart"></canvas>
        </div>

        <div class="chart-box">
            <h4>📋 Tổng hợp đơn/phiếu</h4>
            <canvas id="applicationChart"></canvas>
        </div>

    </div>

    <!-- ================= 3 cột ngang ================= -->

    <div class="status-columns">

        <!-- Pending -->

        <div class="status-column">

            <div class="section-title">
                <h2>🟡 Chờ duyệt</h2>
                <span id="pendingCount"><%= pendingCount %> mục</span>
            </div>

            <div class="status-column-body" id="pendingColumnBody">

                <% if(pendingApplications.length === 0){ %>

                    <div class="empty-card">
                        Không có dữ liệu.
                    </div>

                <% } %>

                <% pendingApplications.forEach(item => { %>

                    <% if(item.type === "translator"){ %>

                        <% const application = item.data; %>

                        <div class="application-list-card" id="item-application-<%= application._id %>">

                            <div class="application-left">

                                <img
                                    src="<%= application.user.avatar || '/images/icon/avatar.png' %>"
                                    class="user-avatar"
                                    onerror="this.onerror=null;this.src='/images/icon/avatar.png'">

                                <div>

                                    <h3>
                                        👤 <%= application.groupName || application.user.username %>
                                    </h3>

                                    <p>
                                        <%= application.user.email %>
                                    </p>

                                    <small>
                                        Đơn Translator •
                                        <%= application.createdAt.toLocaleDateString('vi-VN') %>
                                    </small>

                                </div>

                            </div>

                            <div class="application-right">

                                <span class="status pending">
                                    Translator
                                </span>

                                <button
                                    class="view-btn"
                                    onclick="openApplication('<%= application._id %>')">

                                    👁 Xem đơn

                                </button>

                            </div>

                        </div>

                    <% } else { %>

                        <% const manga = item.data; %>

                        <div class="application-list-card" id="item-manga-<%= manga._id %>">

                            <div class="application-left">

                                <img
                                    src="<%= manga.cover || '/images/default-cover.jpg' %>"
                                    class="manga-cover-thumb"
                                    onerror="this.onerror=null;this.src='/images/default-cover.jpg'">

                                <div>

                                    <h3>
                                        📖 <%= manga.title %>
                                    </h3>

                                    <p>
                                        <%= manga.translator.username %>
                                    </p>

                                    <small>
                                        Truyện •
                                        <%= manga.createdAt.toLocaleDateString('vi-VN') %>
                                    </small>

                                </div>

                            </div>

                            <div class="application-right">

                                <span class="status pending">
                                    Manga
                                </span>

                                <button
                                    class="view-btn"
                                    onclick="openManga('<%= manga._id %>')">

                                    👁 Xem truyện

                                </button>

                            </div>

                        </div>

                    <% } %>

                <% }) %>

            </div>

        </div>

        <!-- Approved -->

        <div class="status-column">

            <div class="section-title">
                <h2>🟢 Đã duyệt</h2>
                <span id="approvedCount"><%= approvedCount %> mục</span>
            </div>

            <div class="status-column-body" id="approvedColumnBody">

                <% if(approvedApplications.length === 0){ %>

                    <div class="empty-card">
                        Chưa có dữ liệu.
                    </div>

                <% } %>

                <% approvedApplications.forEach(item => { %>

                    <% if(item.type === "translator"){ %>

                        <% const application = item.data; %>

                        <div class="application-list-card" id="item-application-<%= application._id %>">

                            <div class="application-left">

                                <img
                                    src="<%= application.user.avatar || '/images/icon/avatar.png' %>"
                                    class="user-avatar"
                                    onerror="this.onerror=null;this.src='/images/icon/avatar.png'">

                                <div>

                                    <h3>
                                        👤 <%= application.groupName || application.user.username %>
                                    </h3>

                                    <p>
                                        <%= application.user.email %>
                                    </p>

                                    <small>
                                        Đơn Translator •
                                        <%= application.updatedAt.toLocaleDateString('vi-VN') %>
                                    </small>

                                </div>

                            </div>

                            <div class="application-right">

                                <span class="status approved">
                                    Translator
                                </span>

                                <button
                                    class="view-btn"
                                    onclick="openApplication('<%= application._id %>')">

                                    👁 Xem

                                </button>

                            </div>

                        </div>

                    <% } else { %>

                        <% const manga = item.data; %>

                        <div class="application-list-card" id="item-manga-<%= manga._id %>">

                            <div class="application-left">

                                <img
                                    src="<%= manga.cover || '/images/default-cover.jpg' %>"
                                    class="manga-cover-thumb"
                                    onerror="this.onerror=null;this.src='/images/default-cover.jpg'">

                                <div>

                                    <h3>
                                        📖 <%= manga.title %>
                                    </h3>

                                    <p>
                                        <%= manga.translator.username %>
                                    </p>

                                    <small>
                                        Truyện •
                                        <%= manga.updatedAt.toLocaleDateString('vi-VN') %>
                                    </small>

                                </div>

                            </div>

                            <div class="application-right">

                                <span class="status approved">
                                    Manga
                                </span>

                                <button
                                    class="view-btn"
                                    onclick="openManga('<%= manga._id %>')">

                                    👁 Xem truyện

                                </button>

                            </div>

                        </div>

                    <% } %>

                <% }) %>

            </div>

        </div>

        <!-- Rejected -->

        <div class="status-column">

            <div class="section-title">
                <h2>🔴 Đã từ chối</h2>
                <span id="rejectedCount"><%= rejectedCount %> mục</span>
            </div>

            <div class="status-column-body" id="rejectedColumnBody">

                <% if(rejectedApplications.length === 0){ %>

                    <div class="empty-card">
                        Chưa có dữ liệu.
                    </div>

                <% } %>

                <% rejectedApplications.forEach(item => { %>

                    <% if(item.type === "translator"){ %>

                        <% const application = item.data; %>

                        <div class="application-list-card" id="item-application-<%= application._id %>">

                            <div class="application-left">

                                <img
                                    src="<%= application.user.avatar || '/images/icon/avatar.png' %>"
                                    class="user-avatar"
                                    onerror="this.onerror=null;this.src='/images/icon/avatar.png'">

                                <div>

                                    <h3>
                                        👤 <%= application.groupName || application.user.username %>
                                    </h3>

                                    <p>
                                        <%= application.user.email %>
                                    </p>

                                    <small>
                                        Đơn Translator •
                                        <%= application.updatedAt.toLocaleDateString('vi-VN') %>
                                    </small>

                                </div>

                            </div>

                            <div class="application-right">

                                <span class="status rejected">
                                    Translator
                                </span>

                                <button
                                    class="view-btn"
                                    onclick="openApplication('<%= application._id %>')">

                                    👁 Xem đơn

                                </button>

                            </div>

                        </div>

                    <% } else { %>

                        <% const manga = item.data; %>

                        <div class="application-list-card" id="item-manga-<%= manga._id %>">

                            <div class="application-left">

                                <img
                                    src="<%= manga.cover || '/images/default-cover.jpg' %>"
                                    class="manga-cover-thumb"
                                    onerror="this.onerror=null;this.src='/images/default-cover.jpg'">

                                <div>

                                    <h3>
                                        📖 <%= manga.title %>
                                    </h3>

                                    <p>
                                        <%= manga.translator.username %>
                                    </p>

                                    <small>
                                        Truyện •
                                        <%= manga.updatedAt.toLocaleDateString('vi-VN') %>
                                    </small>

                                </div>

                            </div>

                            <div class="application-right">

                                <span class="status rejected">
                                    Manga
                                </span>

                                <button
                                    class="view-btn"
                                    onclick="openManga('<%= manga._id %>')">

                                    👁 Xem truyện

                                </button>

                            </div>

                        </div>

                    <% } %>

                <% }) %>

            </div>

        </div>

    </div>

<!-- ================= Quản lý User / Translator ================= -->

<div class="management-row">

    <!-- User -->
    <div class="management-col">

        <h2>👤 Quản lý User (<%= allUsers.length %>)</h2>

        <div class="management-list">

            <% if(allUsers.length === 0){ %>
                <div class="management-empty">
                    Không có tài khoản nào.
                </div>
            <% } %>

            <% allUsers.forEach(u => { %>

                <div class="management-item"
                     id="account-<%= u._id %>"
                     data-status="<%= u.status %>">

                    <img
                        src="<%= u.avatar || '/images/icon/avatar.png' %>"
                        onerror="this.onerror=null;this.src='/images/icon/avatar.png'">

                    <div class="management-info">

                        <strong><%= u.username %></strong>

                        <span><%= u.email %></span>

                        <span
                            id="badge-<%= u._id %>"
                            class="management-badge <%= u.status %>">

                            <%= u.status === "banned" ? "Đã khóa" : "Hoạt động" %>

                        </span>

                    </div>

                    <div class="management-actions">

                        <button
                            id="ban-btn-<%= u._id %>"
                            class="<%= u.status === 'banned' ? 'btn-unlock' : 'btn-lock' %>"
                            onclick="banUser('<%= u._id %>')">

                            <%= u.status === "banned" ? "Mở khóa" : "Ban" %>

                        </button>

                        <button
                            class="btn-delete-account"
                            onclick="deleteAccount('<%= u._id %>')">

                            Xóa

                        </button>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

    <!-- Translator -->

    <div class="management-col">

        <h2>📚 Quản lý Translator (<%= allTranslators.length %>)</h2>

        <div class="management-list">

            <% if(allTranslators.length === 0){ %>

                <div class="management-empty">
                    Không có tài khoản nào.
                </div>

            <% } %>

            <% allTranslators.forEach(t => { %>

                <div class="management-item"
                     id="account-<%= t._id %>"
                     data-status="<%= t.status %>">

                    <img
                        src="<%= t.avatar || '/images/icon/avatar.png' %>"
                        onerror="this.onerror=null;this.src='/images/icon/avatar.png'">

                    <div class="management-info">

                        <strong><%= t.displayName || t.username %></strong>

                        <span><%= t.email %></span>

                        <span
                            id="badge-<%= t._id %>"
                            class="management-badge <%= t.status %>">

                            <%= t.status === "banned" ? "Đã khóa" : "Hoạt động" %>

                        </span>

                    </div>

                    <div class="management-actions">

                        <button
                            id="ban-btn-<%= t._id %>"
                            class="<%= t.status === 'banned' ? 'btn-unlock' : 'btn-lock' %>"
                            onclick="banUser('<%= t._id %>')">

                            <%= t.status === "banned" ? "Mở khóa" : "Ban" %>

                        </button>

                        <button
                            class="btn-delete-account"
                            onclick="deleteAccount('<%= t._id %>')">

                            Xóa

                        </button>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</div>

<!-- ================= Nhật ký bình luận ================= -->

<div class="management-row">

    <div class="management-col full-width">

        <h2>💬 Nhật ký bình luận (<%= recentComments.length %> gần đây)</h2>

        <div class="management-list comment-log-list">

            <% if(recentComments.length === 0){ %>
                <div class="management-empty">
                    Chưa có bình luận nào.
                </div>
            <% } %>

            <% recentComments.forEach(c => { %>

                <div class="comment-log-item"
                     id="comment-log-<%= c._id %>"
                     data-hidden="<%= c.isHidden ? 'true' : 'false' %>">

                    <img
                        src="<%= c.user?.avatar || '/images/icon/avatar.png' %>"
                        onerror="this.onerror=null;this.src='/images/icon/avatar.png'">

                    <div class="comment-log-info">

                        <div class="comment-log-top">

                            <strong>
                                <%= c.user ? (c.user.displayName || c.user.username) : "Người dùng đã xóa" %>
                            </strong>

                            <span class="comment-log-time">
                                <%= new Date(c.createdAt).toLocaleString('vi-VN') %>
                            </span>

                            <span
                                id="comment-log-badge-<%= c._id %>"
                                class="management-badge <%= c.isHidden ? 'banned' : 'active' %>">

                                <%= c.isHidden ? "Đã ẩn" : "Hiển thị" %>

                            </span>

                        </div>

                        <div class="comment-log-manga">
                            Bình luận tại:
                            <% if(c.manga && c.chapter){ %>
                                <a href="/manga/<%= c.manga.slug %>/chapter/<%= c.chapter.chapterNumber %>" target="_blank"><%= c.manga.title %> - Chương <%= c.chapter.chapterNumber %></a>
                            <% } else if(c.manga){ %>
                                <a href="/manga/<%= c.manga.slug %>" target="_blank"><%= c.manga.title %></a>
                            <% } else { %>
                                <em>Truyện đã bị xóa</em>
                            <% } %>
                        </div>

                        <div class="comment-log-content">
                            <%= c.content %>
                        </div>

                        <div
                            id="comment-log-reason-<%= c._id %>"
                            class="chapter-log-reason"
                            style="<%= (c.isHidden && c.hiddenReason) ? '' : 'display:none;' %>">
                            ⚠️ Lý do ẩn: <span><%= c.hiddenReason %></span>
                        </div>

                    </div>

                    <div class="management-actions comment-log-actions">

                        <button
                            id="comment-hide-btn-<%= c._id %>"
                            class="<%= c.isHidden ? 'btn-unlock' : 'btn-lock' %>"
                            onclick="toggleHideComment('<%= c._id %>')">

                            <%= c.isHidden ? "Hiện" : "Ẩn" %>

                        </button>

                        <button
                            class="btn-delete-account"
                            onclick="deleteCommentAdmin('<%= c._id %>')">

                            Xóa

                        </button>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</div>

<!-- ================= Nhật ký chương truyện ================= -->

<div class="management-row">

    <div class="management-col full-width">

        <h2>📖 Nhật ký chương truyện (<%= recentChapters.length %> gần đây)</h2>

        <div class="management-list chapter-log-list">

            <% if(recentChapters.length === 0){ %>
                <div class="management-empty">
                    Chưa có chương nào.
                </div>
            <% } %>

            <% recentChapters.forEach(ch => { %>

                <div class="chapter-log-item"
                     id="chapter-log-<%= ch._id %>"
                     data-hidden="<%= ch.isHidden ? 'true' : 'false' %>">

                    <img
                        src="<%= ch.manga?.cover || '/images/default-cover.jpg' %>"
                        class="chapter-log-cover"
                        onerror="this.onerror=null;this.src='/images/default-cover.jpg'">

                    <div class="comment-log-info">

                        <div class="comment-log-top">

                            <strong>
                                <% if(ch.manga){ %>
                                    <a href="/manga/<%= ch.manga.slug %>" target="_blank"><%= ch.manga.title %></a>
                                <% } else { %>
                                    Truyện đã bị xóa
                                <% } %>
                            </strong>

                            <span class="comment-log-time">
                                <%= new Date(ch.createdAt).toLocaleString('vi-VN') %>
                            </span>

                            <span
                                id="chapter-log-badge-<%= ch._id %>"
                                class="management-badge <%= ch.isHidden ? 'banned' : 'active' %>">

                                <%= ch.isHidden ? "Đã ẩn" : "Hiển thị" %>

                            </span>

                        </div>

                        <div class="comment-log-manga">
                            Chương <b><%= ch.chapterNumber %></b>
                            <% if(ch.title && ch.title !== "Không có tiêu đề"){ %>
                                — <%= ch.title %>
                            <% } %>
                            • Đăng bởi
                            <b><%= ch.uploadedBy ? (ch.uploadedBy.displayName || ch.uploadedBy.username) : "Không rõ" %></b>
                        </div>

                        <% if(ch.isHidden && ch.hiddenReason){ %>
                            <div class="chapter-log-reason">
                                ⚠️ Lý do ẩn: <%= ch.hiddenReason %>
                            </div>
                        <% } %>

                    </div>

                    <div class="management-actions comment-log-actions">

                        <button
                            id="chapter-hide-btn-<%= ch._id %>"
                            class="<%= ch.isHidden ? 'btn-unlock' : 'btn-lock' %>"
                            onclick="toggleHideChapter('<%= ch._id %>')">

                            <%= ch.isHidden ? "Hiện" : "Ẩn" %>

                        </button>

                        <button
                            class="btn-delete-account"
                            onclick="deleteChapterAdmin('<%= ch._id %>')">

                            Xóa

                        </button>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</div>

<!-- ================= Modal đơn (giữ nguyên) ================= -->

<div id="applicationModal" class="application-modal">

    <div class="application-modal-content">

        <span
            class="close-modal"
            onclick="closeApplication()">

            &times;

        </span>

        <div id="applicationContent">

            <div class="loading">

                ⏳ Đang tải dữ liệu...

            </div>

        </div>

    </div>

</div>

<!-- ================= Quản lý thể loại ================= -->

<div class="management-row" id="category-section">

    <div class="management-col full-width">

        <h2>🏷️ Quản lý thể loại (<%= categories.length %>)</h2>

        <form
            action="/admin/category"
            method="POST"
            class="category-add-form">

            <input
                type="text"
                name="name"
                placeholder="Tên thể loại mới, ví dụ: Isekai"
                required>

            <button type="submit" class="btn-add-category">
                ➕ Thêm thể loại
            </button>

        </form>

        <div class="category-list">

            <% if(categories.length === 0){ %>
                <div class="management-empty">
                    Chưa có thể loại nào.
                </div>
            <% } %>

            <% categories.forEach(c => { %>

                <div class="category-chip">

                    <span><%= c.name %></span>

                    <form
                        action="/admin/category/<%= c._id %>/delete"
                        method="POST"
                        onsubmit="return confirm('Xóa thể loại &quot;<%= c.name %>&quot;? Các truyện đã gắn thể loại này vẫn giữ nguyên, chỉ không còn xuất hiện trong danh sách chọn khi đăng truyện mới.');">

                        <button type="submit" class="btn-remove-category" title="Xóa thể loại">
                            ✕
                        </button>

                    </form>

                </div>

            <% }) %>

        </div>

    </div>

</div>

<!-- ================= Popup ảnh (giữ nguyên) ================= -->

<div id="imageModal" class="image-modal">

    <span id="closeImage">&times;</span>

    <img id="modalImage">

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/admin-dashboard.js"></script>

