<script>
document.addEventListener("DOMContentLoaded", function () {

    new Chart(document.getElementById("accountChart"), {
        type: "doughnut",
        data: {
            labels: ["User", "Translator", "Admin"],
            datasets: [{
                data: [<%= totalUsers %>, <%= totalTranslators %>, <%= totalAdmins %>],
                backgroundColor: ["#5865F2", "#22c55e", "#f59e0b"],
                borderWidth: 0,
            }]
        },
        options: {
            plugins: {
                legend: { position: "bottom", labels: { color: "#fff" } }
            }
        }
    });

    new Chart(document.getElementById("genreChart"), {
        type: "doughnut",
        data: {
            labels: <%- JSON.stringify(genreLabels) %>,
            datasets: [{
                data: <%- JSON.stringify(genreCounts) %>,
                backgroundColor: [
                    "#5865F2","#22c55e","#f59e0b","#ef4444","#a855f7","#06b6d4","#ec4899","#84cc16",
                    "#f97316","#14b8a6","#8b5cf6","#eab308","#f43f5e","#0ea5e9","#65a30d","#d946ef",
                    "#fb923c","#2dd4bf","#c084fc","#facc15","#fb7185","#38bdf8","#a3e635","#e879f9",
                    "#fdba74","#5eead4"
                ],
                borderWidth: 0,
            }]
        },
        options: {
            plugins: {
                legend: { position: "bottom", labels: { color: "#fff", boxWidth: 12, font: { size: 11 } } }
            }
        }
    });

    new Chart(document.getElementById("applicationChart"), {
        type: "doughnut",
        data: {
            labels: ["Chờ duyệt", "Đã duyệt", "Đã từ chối"],
            datasets: [{
                data: [<%= pendingCount %>, <%= approvedCount %>, <%= rejectedCount %>],
                backgroundColor: ["#facc15", "#22c55e", "#ef4444"],
                borderWidth: 0,
            }]
        },
        options: {
            plugins: {
                legend: { position: "bottom", labels: { color: "#fff" } }
            }
        }
    });

});

// ==========================
// Khóa / Mở khóa tài khoản
// ==========================

async function banUser(id){

    const row=document.getElementById(`account-${id}`);
    const badge=document.getElementById(`badge-${id}`);
    const btn=document.getElementById(`ban-btn-${id}`);

    const currentStatus=row.dataset.status;

    if(currentStatus==="banned"){

        const ok=await Swal.fire({

            title:"Mở khóa tài khoản?",

            icon:"question",

            background:"#1f2432",

            color:"#fff",

            showCancelButton:true,

            confirmButtonText:"Mở khóa",

            cancelButtonText:"Huỷ",

            confirmButtonColor:"#5865F2"

        });

        if(!ok.isConfirmed) return;

        const res=await fetch(`/admin/user/${id}/unban`,{

            method:"POST"

        });

        const data=await res.json();

        if(data.success){

            row.dataset.status="active";

            badge.className="management-badge active";

            badge.innerHTML="Hoạt động";

            btn.className="btn-lock";

            btn.innerHTML="Ban";

            Swal.fire({

                toast:true,

                position:"bottom",

                icon:"success",

                title:"Đã mở khóa",

                showConfirmButton:false,

                timer:2000,

                background:"#1f2432",

                color:"#fff"

            });

        }

        return;

    }

    const {value:form}=await Swal.fire({

        title:"Ban tài khoản",

        background:"#1f2432",

        color:"#fff",

        confirmButtonColor:"#5865F2",

        showCancelButton:true,

        cancelButtonText:"Huỷ",

        html:`

        <select id="banDays" class="swal2-input">

            <option value="1">1 ngày</option>

            <option value="3">3 ngày</option>

            <option value="7">7 ngày</option>

            <option value="30">30 ngày</option>

            <option value="90">90 ngày</option>

            <option value="365">365 ngày</option>

            <option value="-1">Vĩnh viễn</option>

        </select>

        <textarea

        id="banReason"

        class="swal2-textarea"

        placeholder="Lý do khóa"></textarea>

        `,

        preConfirm(){

            return{

                days:document.getElementById("banDays").value,

                reason:document.getElementById("banReason").value

            }

        }

    });

    if(!form) return;

    const res=await fetch(`/admin/user/${id}/ban`,{

        method:"POST",

        headers:{

            "Content-Type":"application/json"

        },

        body:JSON.stringify(form)

    });

    const data=await res.json();

    if(data.success){

        row.dataset.status="banned";

        badge.className="management-badge banned";

        badge.innerHTML="Đã khóa";

        btn.className="btn-unlock";

        btn.innerHTML="Mở khóa";

        Swal.fire({

            toast:true,

            position:"bottom",

            icon:"success",

            title:"Đã khóa tài khoản",

            showConfirmButton:false,

            timer:2000,

            background:"#1f2432",

            color:"#fff"

        });

    }else{

        Swal.fire({

            icon:"error",

            title:data.message||"Có lỗi xảy ra",

            background:"#1f2432",

            color:"#fff"

        });

    }

}

