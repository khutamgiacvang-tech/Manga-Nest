async function toggleHideComment(id){

    const item = document.getElementById(`comment-log-${id}`);
    const isHidden = item.dataset.hidden === "true";

    let reason = "";

    if(!isHidden){

        const { value: form, isConfirmed } = await Swal.fire({

            title: "Ẩn bình luận này?",

            text: "Bình luận sẽ bị ẩn khỏi trang đọc truyện. User sẽ nhận được thông báo.",

            icon: "warning",

            background: "#1f2432",

            color: "#fff",

            showCancelButton: true,

            confirmButtonText: "Ẩn",

            cancelButtonText: "Huỷ",

            confirmButtonColor: "#f59e0b",

            input: "text",

            inputPlaceholder: "Lý do ẩn (VD: spam, xúc phạm người khác...)",

            inputAttributes: {
                autocapitalize: "off"
            }

        });

        if(!isConfirmed) return;

        reason = form || "Vi phạm quy định nội dung.";

    }else{

        const ok = await Swal.fire({

            title: "Hiện lại bình luận này?",

            text: "Bình luận sẽ hiển thị lại với mọi người.",

            icon: "question",

            background: "#1f2432",

            color: "#fff",

            showCancelButton: true,

            confirmButtonText: "Hiện",

            cancelButtonText: "Huỷ",

            confirmButtonColor: "#5865F2"

        });

        if(!ok.isConfirmed) return;

    }

    try{

        const res = await fetch(`/admin/comment/${id}/hide`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ reason })
        });

        const data = await res.json();

        if(data.success){

            const badge = document.getElementById(`comment-log-badge-${id}`);
            const btn = document.getElementById(`comment-hide-btn-${id}`);
            const reasonBox = document.getElementById(`comment-log-reason-${id}`);

            item.dataset.hidden = data.isHidden ? "true" : "false";

            badge.className = `management-badge ${data.isHidden ? "banned" : "active"}`;
            badge.innerHTML = data.isHidden ? "Đã ẩn" : "Hiển thị";

            btn.className = data.isHidden ? "btn-unlock" : "btn-lock";
            btn.innerHTML = data.isHidden ? "Hiện" : "Ẩn";

            if(reasonBox){
                if(data.isHidden){
                    reasonBox.style.display = "";
                    reasonBox.querySelector("span").innerHTML = reason;
                }else{
                    reasonBox.style.display = "none";
                }
            }

            Swal.fire({
                toast: true,
                position: "bottom",
                icon: "success",
                title: data.isHidden ? "Đã ẩn bình luận" : "Đã hiện bình luận",
                showConfirmButton: false,
                timer: 2000,
                background: "#1f2432",
                color: "#fff"
            });

        }else{

            Swal.fire({
                title: "Không thể cập nhật",
                text: data.message || "Có lỗi xảy ra.",
                icon: "error",
                background: "#1f2432",
                color: "#fff",
                confirmButtonColor: "#5865F2"
            });

        }

    }catch(err){

        console.error(err);

        Swal.fire({
            title: "Lỗi",
            text: "Có lỗi xảy ra.",
            icon: "error",
            background: "#1f2432",
            color: "#fff",
            confirmButtonColor: "#5865F2"
        });

    }

}

