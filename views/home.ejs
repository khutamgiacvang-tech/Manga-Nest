<!-- =========================
        HERO CAROUSEL
========================= -->

<section class="hero">

    <div class="hero-track" id="heroTrack">

        <% mangas.slice(0,5).forEach((manga, heroIndex) => { %>

        <a href="/manga/<%= manga.slug %>" class="hero-slide">

            <img
                src="<%= manga.banner || manga.cover %>"
                alt="<%= manga.title %>"
                class="hero-banner"
                <% if(heroIndex === 0){ %>
                    fetchpriority="high"
                <% } else { %>
                    loading="lazy"
                <% } %>
                decoding="async"
            >

            <div class="hero-overlay"></div>

            <div class="hero-content">

                <div class="hero-info">

                    <h1><%= manga.title %></h1>

                    <p class="hero-desc">
                        <%= manga.description || "Chưa có mô tả." %>
                    </p>

                </div>

            </div>

            <span class="hero-cta">XEM THÔNG TIN</span>

        </a>

        <% }) %>

    </div>

    <div class="hero-dots" id="heroDots">

        <% mangas.slice(0,5).forEach((manga, i) => { %>

            <button
                type="button"
                class="hero-dot <%= i===0 ? 'active' : '' %>"
                data-index="<%= i %>"
            ></button>

        <% }) %>

    </div>

</section>

<!-- =========================
        TRUYỆN MỚI (cuộn ngang)
========================= -->

<section class="section">

    <div class="section-title">
        <h2>TRUYỆN MỚI</h2>
    </div>

    <div class="row-wrapper">

        <!-- Nút lùi -->

        <button
            type="button"
            class="row-arrow row-arrow-left"
            onclick="document.getElementById('rowNew').scrollBy({left:-600,behavior:'smooth'})"
        >
            ‹
        </button>

        <div class="home-row home-row-new" id="rowNew">

            <% mangas.slice(0,24).forEach(manga => { %>

            <a href="/manga/<%= manga.slug %>" class="home-card">

                <img
                    src="<%= manga.cover || '/images/no-cover.png' %>"
                    alt="<%= manga.title %>"
                    loading="lazy"
                    decoding="async"
                >

                <div class="home-card-body">

                    <h3><%= manga.title %></h3>

                    <p>
                        C. <%= manga.lastChapter || 0 %> -
                        <%= timeAgo(manga.lastChapterDate) %>
                    </p>

                </div>

            </a>

            <% }) %>

        </div>

        <!-- Nút tiến -->

        <button
            type="button"
            class="row-arrow row-arrow-right"
            onclick="document.getElementById('rowNew').scrollBy({left:600,behavior:'smooth'})"
        >
            ›
        </button>

    </div>

    <div class="section-footer">
        <a href="/manga?sort=new">› Xem danh sách truyện mới</a>
    </div>

</section>

<!-- =========================
        TRUYỆN NỔI BẬT (xếp hạng)
========================= -->

<section class="section">

    <div class="section-title">

        <h2>TRUYỆN NỔI BẬT</h2>

        <div class="rank-tabs">

            <button type="button" class="rank-tab active" data-range="week">TUẦN</button>
            <button type="button" class="rank-tab" data-range="month">THÁNG</button>
            <button type="button" class="rank-tab" data-range="all">MỌI LÚC</button>

        </div>

    </div>

    <div class="row-wrapper">

        <!-- Nút trái -->

        <button
            type="button"
            class="row-arrow row-arrow-left"
            onclick="scrollRank(-600)"
        >
            ‹
        </button>

        <!-- TUẦN -->

        <div class="rank-row" id="weekRank">

            <% topWeek.forEach((manga, i) => { %>

            <a href="/manga/<%= manga.slug %>" class="rank-card">

                <img
                    src="<%= manga.cover || '/images/no-cover.png' %>"
                    alt="<%= manga.title %>"
                    loading="lazy"
                    decoding="async"
                >

                <div class="rank-body">

                    <h4><%= manga.title %></h4>

                    <p>
                        CHƯƠNG <%= manga.lastChapter || 0 %> -
                        <%= timeAgo(manga.lastChapterDate) %>
                    </p>

                    <small>
                        <%= (manga.weeklyViews || 0).toLocaleString("vi-VN") %>
                        LƯỢT XEM
                    </small>

                </div>

                <span class="rank-number">
                    <%= String(i + 1).padStart(2,"0") %>
                </span>

            </a>

            <% }) %>

        </div>

        <!-- THÁNG -->

        <div
            class="rank-row"
            id="monthRank"
            style="display:none"
        >

            <% topMonth.slice(0,24).forEach((manga, i) => { %>

            <a href="/manga/<%= manga.slug %>" class="rank-card">

                <img
                    src="<%= manga.cover || '/images/no-cover.png' %>"
                    alt="<%= manga.title %>"
                    loading="lazy"
                    decoding="async"
                >

                <div class="rank-body">

                    <h4><%= manga.title %></h4>

                    <p>
                        CHƯƠNG <%= manga.lastChapter || 0 %> -
                        <%= timeAgo(manga.lastChapterDate) %>
                    </p>

                    <small>
                        <%= (manga.monthlyViews || 0).toLocaleString("vi-VN") %>
                        LƯỢT XEM
                    </small>

                </div>

                <span class="rank-number">
                    <%= String(i + 1).padStart(2,"0") %>
                </span>

            </a>

            <% }) %>

        </div>

        <!-- MỌI LÚC -->

        <div
            class="rank-row"
            id="allRank"
            style="display:none"
        >

            <% topAll.slice(0,24).forEach((manga, i) => { %>

            <a href="/manga/<%= manga.slug %>" class="rank-card">

                <img
                    src="<%= manga.cover || '/images/no-cover.png' %>"
                    alt="<%= manga.title %>"
                    loading="lazy"
                    decoding="async"
                >

                <div class="rank-body">

                    <h4><%= manga.title %></h4>

                    <p>
                        CHƯƠNG <%= manga.lastChapter || 0 %> -
                        <%= timeAgo(manga.lastChapterDate) %>
                    </p>

                    <small>
                        <%= (manga.views || 0).toLocaleString("vi-VN") %>
                        LƯỢT XEM
                    </small>

                </div>

                <span class="rank-number">
                    <%= String(i + 1).padStart(2,"0") %>
                </span>

            </a>

            <% }) %>

        </div>

        <!-- Nút phải -->

        <button
            type="button"
            class="row-arrow row-arrow-right"
            onclick="scrollRank(600)"
        >
            ›
        </button>

    </div>

</section>

