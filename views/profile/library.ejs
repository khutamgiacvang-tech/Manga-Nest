<%
// Helper hiển thị thời gian tương đối kiểu "12 phút trước"
function timeAgo(date){

    if(!date) return "";

    const diff = Date.now() - new Date(date).getTime();

    const mins = Math.floor(diff / 60000);

    if(mins < 1) return "vừa xong";
    if(mins < 60) return mins + " phút trước";

    const hours = Math.floor(mins / 60);
    if(hours < 24) return hours + " giờ trước";

    const days = Math.floor(hours / 24);
    if(days < 30) return days + " ngày trước";

    const months = Math.floor(days / 30);
    if(months < 12) return months + " tháng trước";

    return Math.floor(months / 12) + " năm trước";
}
%>

<div class="manga-list-page">

    <h1 class="page-title">
        ❤️ Danh sách theo dõi
    </h1>

    <% if(mangas.length === 0){ %>

        <div class="empty-box">
            Bạn chưa theo dõi truyện nào.
        </div>

    <% } else { %>

        <div class="list-grid">

            <% mangas.forEach(manga => { %>

                <a href="/manga/<%= manga.slug %>" class="list-card">

                    <img
                        src="<%= manga.cover || '/images/no-cover.png' %>"
                        alt="<%= manga.title %>"
                    >

                    <div class="list-card-body">

                        <h3><%= manga.title %></h3>

                        <p class="list-card-meta">
                            C. <%= manga.lastChapter || 0 %> -
                            <%= timeAgo(manga.lastChapterDate) %>
                        </p>

                    </div>

                </a>

            <% }) %>

        </div>

    <% } %>

    <!-- PHÂN TRANG LUÔN HIỂN THỊ -->
    <div class="pagination">

        <% if(currentPage > 1){ %>

            <a href="/library?page=<%= currentPage - 1 %>" class="page-btn">
                ‹ Trang trước
            </a>

        <% } else { %>

            <span class="page-btn disabled">
                ‹ Trang trước
            </span>

        <% } %>

        <span class="page-number">
            Trang <%= currentPage %> / <%= totalPages %>
        </span>

        <% if(currentPage < totalPages){ %>

            <a href="/library?page=<%= currentPage + 1 %>" class="page-btn">
                Trang sau ›
            </a>

        <% } else { %>

            <span class="page-btn disabled">
                Trang sau ›
            </span>

        <% } %>

    </div>

</div>
